.claude
# The engineering ledger, the single source of truth for open defects.
# Local only: it lists unfixed security findings, and this repo is public.
# Remove this line once the P0 security items in it are fixed, if you want it public.
MASTER_LEDGER.md
SSOT.md

# Local-only working folders. Neither belongs to a clone: LEDGER holds issue drafts
# on their way to the tracker, VLCASTRA holds native probes and their notes.
LEDGER/
VLCASTRA/

# Desktop: leftover downloaded player natives from before the KitePlayer-only desktop build.
# Nothing produces this any more; the entry stays so an old local copy can never be committed.
# The toolchain packs desktopApp/resources/ into the desktop app, so keep no local copy there.
desktopApp/resources/

# Android: build-plugins/android-release unpacks the FFmpeg decoder library here on every build.
androidApp/jniLibs/

# Local backups and state files of KiteConfig, a Gradle plugin. No build step writes them. The
# entries keep local copies out of git.
.kiteconfig/
*.kiteconfig.bak

# Design notes and working documents. Local only, they are not part of the shipped app.
/DESIGN/

# Plan documents written by local tooling. They are not project documentation and docs/ is published.
docs/superpowers/

# The iOS handler tests (swift test)
iosApp/NioHandlerTests/.build/
iosApp/NioHandlerTests/.swiftpm/
