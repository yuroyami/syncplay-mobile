<?xml version="1.0" encoding="utf-8"?>
<!--
  The app plays media links and joins servers that the user types, so any host must stay
  reachable, including LAN addresses and plain HTTP streams. The app's own services must never
  fall back to plain HTTP, because their requests carry the OpenSubtitles key, the KLIPY key and
  the update check.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- The app's own services. HTTPS only, no downgrade, no user CAs. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">opensubtitles.com</domain>
        <domain includeSubdomains="true">klipy.com</domain>
        <domain includeSubdomains="true">ipify.org</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
